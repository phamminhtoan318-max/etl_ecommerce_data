# Mức độ ghi log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG

# -----------------------------------------------------------------------------
# CẤU HÌNH DATABASE NGUỒN: SQL Server (OLTP)
# -----------------------------------------------------------------------------
# Driver ODBC: 'ODBC Driver 17 for SQL Server' hoặc 'ODBC Driver 18 for SQL Server'
SRC_DB_DRIVER=ODBC Driver 17 for SQL Server
# Địa chỉ máy chủ: hostname hoặc IP (ví dụ: localhost, 127.0.0.1, hoặc localhost\SQLEXPRESS)
SRC_DB_SERVER=localhost
# Cổng kết nối: 1433 (để trống nếu dùng Named Instance như localhost\SQLEXPRESS)
SRC_DB_PORT=1433
SRC_DB_NAME=olist
# Xác thực Windows: 'yes' (Windows Auth) hoặc 'no' (SQL Server Auth dùng User/Pass)
SRC_DB_TRUSTED_CONNECTION=no
SRC_DB_TRUST_SERVER_CERTIFICATE=yes
SRC_DB_USER=sa
SRC_DB_PASSWORD=YourStrongPassword123!

# -----------------------------------------------------------------------------
# CẤU HÌNH DATABASE ĐÍCH: PostgreSQL Data Warehouse (Staging)
# -----------------------------------------------------------------------------
TGT_DB_HOST=localhost
TGT_DB_PORT=5432
TGT_DB_NAME=olist_dwh
TGT_DB_USER=postgres
TGT_DB_PASSWORD=postgres
TGT_DB_SCHEMA=raw
